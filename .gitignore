# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual environments ---
venv/
env/
ENV/
.venv/
.env

# --- Jupyter ---
.ipynb_checkpoints/

# --- Data (large/raw files should not be committed) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# --- Model artifacts (regenerable via main.py; can be large) ---
models/*
!models/.gitkeep

# --- Generated plots (regenerable via main.py) ---
plots/*
!plots/.gitkeep

# --- Logs ---
logs/*
!logs/.gitkeep
*.log

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- OS ---
Thumbs.db

# --- Distribution / packaging ---
*.manifest
*.spec
